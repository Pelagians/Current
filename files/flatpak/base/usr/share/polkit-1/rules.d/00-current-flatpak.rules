// Run before upstream org.freedesktop.Flatpak.rules and distro 50-default.rules.
// ES5 only. Scope administrator identities to Flatpak, never other services.
polkit.addAdminRule(function (action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") === 0) {
        return ["unix-group:wheel"];
    }
});

polkit.addRule(function (action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") !== 0) {
        return polkit.Result.NOT_HANDLED;
    }

    // These upstream actions deploy verified metadata/AppStream, not apps.
    if ((action.id === "org.freedesktop.Flatpak.appstream-update" ||
         action.id === "org.freedesktop.Flatpak.metadata-update") &&
        subject.local === true && subject.active === true) {
        return polkit.Result.YES;
    }

    // Includes install, update, downgrade, remove, repository/config changes,
    // parental-control overrides, and future privileged Flatpak action IDs.
    if (!subject.isInGroup("wheel")) {
        return polkit.Result.NO;
    }
    return polkit.Result.AUTH_ADMIN; // No cached AUTH_ADMIN_KEEP or silent YES.
});
