#!/usr/bin/env bash
set -euo pipefail

# Tests source this file and set root_dir; production always uses the host root.
root_dir=""
desktop_env_file="/usr/share/current/workstation/desktop.env"
managed_units=(gdm.service cosmic-greeter.service greetd.service)

log() {
  printf 'current-workstation-dm-apply: %s\n' "$*" >&2
}

fail() {
  log "$*"
  return 1
}

validate_destination() {
  local marker="${root_dir}${desktop_env_file}"
  [[ -r "$marker" ]] || { fail "desktop marker is missing: $marker"; return 1; }
  # The image marker is data, not shell code or a retained /etc preference.
  case "$(cat "$marker")" in
    CURRENT_DESKTOP=gnome) selected=gdm.service; session=gnome.desktop ;;
    CURRENT_DESKTOP=cosmic) selected=cosmic-greeter.service; session=cosmic.desktop ;;
    *) fail "invalid CURRENT_DESKTOP in $marker (expected gnome or cosmic)"; return 1 ;;
  esac
  vendor_unit="${root_dir}/usr/lib/systemd/system/${selected}"
  [[ -f "$vendor_unit" ]] || { fail "missing destination unit: $selected ($vendor_unit)"; return 1; }
  grep -Eq '^Alias=.*\bdisplay-manager\.service\b' "$vendor_unit" || {
    fail "$selected does not provide Alias=display-manager.service"; return 1;
  }
  [[ -r "${root_dir}/usr/share/wayland-sessions/$session" ]] || {
    fail "missing destination session: $session"; return 1;
  }
  if [[ "$selected" == cosmic-greeter.service ]]; then
    [[ -r "${root_dir}/etc/greetd/cosmic-greeter.toml" ]] || {
      fail "missing COSMIC configuration: /etc/greetd/cosmic-greeter.toml"; return 1;
    }
    [[ -r "${root_dir}/etc/pam.d/cosmic-greeter" || -r "${root_dir}/usr/lib/pam.d/cosmic-greeter" ]] || {
      fail "missing COSMIC PAM stack in /etc/pam.d or /usr/lib/pam.d"; return 1;
    }
  else
    [[ -r "${root_dir}/etc/gdm/custom.conf" ]] || {
      fail "missing GDM configuration: /etc/gdm/custom.conf"; return 1;
    }
  fi
}

persistent_systemctl() {
  # Offline operations avoid implicit reloads halfway through reconciliation.
  systemctl --root="${root_dir:-/}" --no-reload "$@"
}

verify_alias() {
  local alias="${root_dir}/etc/systemd/system/display-manager.service" target resolved
  [[ -L "$alias" ]] || { fail "display-manager.service is not a symlink for $selected"; return 1; }
  target="$(readlink "$alias")"
  if [[ "$target" == /* ]]; then
    target="${root_dir}${target}"
  else
    target="$(dirname "$alias")/$target"
  fi
  resolved="$(readlink -e "$target")" || {
    fail "dangling display-manager.service alias: $(readlink "$alias")"; return 1;
  }
  [[ "$resolved" == "$(readlink -e "$vendor_unit")" ]] || {
    fail "wrong or masked display-manager.service alias: $resolved (expected $selected)"; return 1;
  }
}

select_destination() {
  local system_dir="${root_dir}/etc/systemd/system" saved path
  mkdir -p "$system_dir" || return 1
  # Regular unit overrides are administrator configuration, not stale masks.
  for path in display-manager.service "$selected"; do
    if [[ -e "$system_dir/$path" && ! -L "$system_dir/$path" ]]; then
      fail "administrator unit override at $system_dir/$path; use /etc/current/workstation-dm-unmanaged to take ownership"
      return 1
    fi
  done
  saved="$(mktemp -d)" || return 1
  for path in display-manager.service "$selected"; do
    if [[ -L "$system_dir/$path" ]]; then
      cp -a "$system_dir/$path" "$saved/$path" || { rm -rf "$saved"; return 1; }
    fi
  done
  if [[ "$(readlink "$system_dir/$selected" || :)" == /dev/null ]]; then
    log "removing stale mask on selected $selected"
  fi
  if persistent_systemctl unmask "$selected" display-manager.service &&
     persistent_systemctl enable --force "$selected" && verify_alias; then
    rm -rf "$saved"
    return 0
  fi
  log "failed to select $selected; restoring previous alias and selected-unit mask"
  for path in display-manager.service "$selected"; do
    rm -f "$system_dir/$path"
    if [[ -L "$saved/$path" ]]; then cp -a "$saved/$path" "$system_dir/$path"; fi
  done
  rm -rf "$saved"
  return 1
}

retire_competitors() {
  local unit link
  for unit in "${managed_units[@]}"; do
    [[ "$unit" != "$selected" ]] || continue
    if [[ -f "${root_dir}/usr/lib/systemd/system/$unit" ]]; then
      persistent_systemctl disable "$unit" || { fail "failed to disable competitor $unit"; return 1; }
      systemctl stop --no-block "$unit" || { fail "failed to queue stop of $unit"; return 1; }
    fi
    # Even an absent package can leave a dangling enablement link after rebase.
    while IFS= read -r -d '' link; do rm -f "$link"; done < <(
      find "${root_dir}/etc/systemd/system" -path '*.wants/*' -type l -name "$unit" -print0
    )
  done
}

pam_gnome_keyring_available() {
  [[ -f /usr/lib/security/pam_gnome_keyring.so || -f /usr/lib64/security/pam_gnome_keyring.so ]]
}

insert_line_after_match() {
  local file="$1"
  local match="$2"
  local line="$3"
  local tmp

  if grep -Fqx "${line}" "${file}"; then
    return 0
  fi

  tmp="$(mktemp)"
  awk -v match="${match}" -v line="${line}" '
    {
      print
      if (!inserted && $0 ~ match) {
        print line
        inserted=1
      }
    }
    END {
      if (!inserted) {
        print line
      }
    }
  ' "${file}" > "${tmp}"
  cat "${tmp}" > "${file}"
  rm -f "${tmp}"
}

ensure_cosmic_keyring_pam() {
  local pam_file="/etc/pam.d/cosmic-greeter"

  if [[ ! -f "${pam_file}" ]]; then
    log "COSMIC PAM file is missing: ${pam_file}"
    return 1
  fi

  if ! pam_gnome_keyring_available; then
    log "pam_gnome_keyring.so is not installed; skipping COSMIC keyring PAM reconciliation"
    return 0
  fi

  insert_line_after_match "${pam_file}" '^auth[[:space:]].*login([[:space:]]|$)' 'auth optional pam_gnome_keyring.so'
  insert_line_after_match "${pam_file}" '^session[[:space:]].*login([[:space:]]|$)' 'session optional pam_gnome_keyring.so auto_start'
}

main() {
  if [[ -e "${root_dir}/etc/current/workstation-dm-unmanaged" ]]; then
    log "administrator owns display-manager selection (workstation-dm-unmanaged)"
    return 0
  fi
  validate_destination || return 1
  log "selecting $selected ($session)"
  select_destination || return 1
  # Only retire the old owner after the replacement has been selected and checked.
  retire_competitors || return 1
  verify_alias || return 1
  persistent_systemctl set-default graphical.target || { fail "failed to set graphical.target"; return 1; }
  systemctl daemon-reload || { fail "failed to reload display-manager units"; return 1; }
  if [[ "$selected" == cosmic-greeter.service && -f "${root_dir}/etc/pam.d/cosmic-greeter" ]]; then
    ensure_cosmic_keyring_pam || return 1
  fi
  systemctl start --no-block "$selected" || { fail "failed to queue startup of $selected"; return 1; }
  log "selected $selected; persistent alias verified"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
