#!/usr/bin/env bash

set -euo pipefail

desktop_env_file="/usr/share/current/workstation/desktop.env"

log() {
  printf 'current-workstation-dm-apply: %s\n' "$*"
}

have_unit() {
  local unit="$1"
  [[ -f "/usr/lib/systemd/system/${unit}" || -f "/etc/systemd/system/${unit}" ]] \
    || systemctl list-unit-files "${unit}" --no-legend >/dev/null 2>&1
}

disable_unit() {
  local unit="$1"
  if have_unit "${unit}"; then
    systemctl disable "${unit}" >/dev/null 2>&1 || true
  fi
}

stop_unit() {
  local unit="$1"
  if have_unit "${unit}"; then
    systemctl stop --no-block "${unit}" >/dev/null 2>&1 || true
  fi
}

reset_failed_unit() {
  local unit="$1"
  if have_unit "${unit}"; then
    systemctl reset-failed "${unit}" >/dev/null 2>&1 || true
  fi
}

retire_unit() {
  local unit="$1"
  disable_unit "${unit}"
  stop_unit "${unit}"
  reset_failed_unit "${unit}"
}

enable_unit() {
  local unit="$1"
  if ! have_unit "${unit}"; then
    return 1
  fi

  systemctl enable --force "${unit}" >/dev/null 2>&1
}

start_unit() {
  local unit="$1"
  # Queue the display-manager start in the current boot transaction without
  # blocking on a unit that is explicitly ordered after this helper.
  systemctl start --no-block "${unit}" >/dev/null 2>&1
}

cleanup_display_manager_links() {
  rm -f \
    /etc/systemd/system/display-manager.service \
    /etc/systemd/system/graphical.target.wants/gdm.service \
    /etc/systemd/system/graphical.target.wants/cosmic-greeter.service \
    /etc/systemd/system/graphical.target.wants/greetd.service
}

ensure_graphical_default() {
  local default_target
  default_target="$(readlink -f /etc/systemd/system/default.target 2>/dev/null || true)"
  if [[ "${default_target}" != "/usr/lib/systemd/system/graphical.target" ]]; then
    systemctl set-default graphical.target >/dev/null 2>&1 || true
  fi
}

ensure_display_manager_alias() {
  if [[ ! -L /etc/systemd/system/display-manager.service ]]; then
    log "display-manager.service alias was not recreated for ${1}"
    return 1
  fi
}

pam_gnome_keyring_available() {
  [[ -f /usr/lib/security/pam_gnome_keyring.so || -f /usr/lib64/security/pam_gnome_keyring.so ]]
}

insert_line_after_match() {
  local file="$1"
  local match="$2"
  local line="$3"
  local tmp

  if grep -Fqx "${line}" "${file}"; then
    return 0
  fi

  tmp="$(mktemp)"
  awk -v pattern="${match}" -v line="${line}" '
    {
      print
      if (!inserted && $0 ~ pattern) {
        print line
        inserted=1
      }
    }
    END {
      if (!inserted) {
        print line
      }
    }
  ' "${file}" > "${tmp}"
  cat "${tmp}" > "${file}"
  rm -f "${tmp}"
}

ensure_cosmic_keyring_pam() {
  local pam_file="${1:-/etc/pam.d/cosmic-greeter}"
  local vendor_pam_file="${2:-/usr/lib/pam.d/cosmic-greeter}"
  local managed_marker="# Managed by Current from /usr/lib/pam.d/cosmic-greeter"
  local tmp

  # Recent COSMIC packages ship the PAM stack under /usr/lib. PAM reads that
  # location until an /etc override exists. Regenerate only our own override
  # on each boot so package updates to the vendor stack are not hidden.
  if [[ -L "${pam_file}" ]]; then
    log "COSMIC PAM file is a symlink; leaving it untouched: ${pam_file}"
    return 0
  fi
  if [[ ! -f "${pam_file}" && ! -f "${vendor_pam_file}" ]]; then
    log "COSMIC PAM file is missing from /etc/pam.d and /usr/lib/pam.d"
    return 1
  fi
  if ! pam_gnome_keyring_available; then
    log "pam_gnome_keyring.so is not installed; skipping COSMIC keyring PAM reconciliation"
    return 0
  fi
  if [[ -f "${vendor_pam_file}" ]] &&
     { [[ ! -e "${pam_file}" ]] || [[ "$(head -n 1 "${pam_file}")" == "${managed_marker}" ]]; }; then
    tmp="$(mktemp "$(dirname "${pam_file}")/.cosmic-greeter.XXXXXX")"
    if ! { printf '%s\n' "${managed_marker}"; cat "${vendor_pam_file}"; } > "${tmp}" ||
       ! chmod 0644 "${tmp}" || ! mv -f "${tmp}" "${pam_file}"; then
      rm -f "${tmp}"
      log "failed to install COSMIC PAM override from ${vendor_pam_file}"
      return 1
    fi
  fi

  insert_line_after_match "${pam_file}" '^auth[[:space:]].*login([[:space:]]|$)' 'auth optional pam_gnome_keyring.so'
  insert_line_after_match "${pam_file}" '^session[[:space:]].*login([[:space:]]|$)' 'session optional pam_gnome_keyring.so auto_start'
}

main() {
  if [[ ! -r "${desktop_env_file}" ]]; then
    return 0
  fi

  # shellcheck disable=SC1090
  . "${desktop_env_file}"

  ensure_graphical_default
  cleanup_display_manager_links
  systemctl daemon-reload >/dev/null 2>&1 || true

  case "${CURRENT_DESKTOP:-}" in
  gnome)
    log "selecting GDM for GNOME"
    retire_unit cosmic-greeter.service
    retire_unit greetd.service
    if ! enable_unit gdm.service; then
      log "gdm.service is not available"
      exit 1
    fi
    ensure_display_manager_alias "gdm.service"
    if ! start_unit gdm.service; then
      log "failed to start gdm.service"
      exit 1
    fi
    ;;
  cosmic)
    log "selecting COSMIC display manager"
    retire_unit gdm.service
    ensure_cosmic_keyring_pam || true
    if have_unit cosmic-greeter.service; then
      retire_unit greetd.service
      if ! enable_unit cosmic-greeter.service; then
        log "failed to enable cosmic-greeter.service"
        exit 1
      fi
      ensure_display_manager_alias "cosmic-greeter.service"
      if ! start_unit cosmic-greeter.service; then
        log "failed to start cosmic-greeter.service"
        exit 1
      fi
    elif have_unit greetd.service; then
      retire_unit cosmic-greeter.service
      if ! enable_unit greetd.service; then
        log "failed to enable greetd.service"
        exit 1
      fi
      ensure_display_manager_alias "greetd.service"
      if ! start_unit greetd.service; then
        log "failed to start greetd.service"
        exit 1
      fi
    else
      log "neither cosmic-greeter.service nor greetd.service is available"
      exit 1
    fi
    ;;
  "")
    log "desktop marker is empty"
    exit 1
    ;;
  *)
    log "unsupported desktop marker: ${CURRENT_DESKTOP}"
    exit 1
    ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
