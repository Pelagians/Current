#!/usr/bin/env bash
set -euo pipefail

# Tests source this file and set root_dir; production always uses the host root.
root_dir=""
desktop_env_file="/usr/share/current/workstation/desktop.env"
managed_units=(gdm.service cosmic-greeter.service greetd.service)

log() {
  printf 'current-workstation-dm-apply: %s\n' "$*" >&2
}

fail() {
  log "$*"
  return 1
}

# Read the inspected INI/TOML scalar contracts without sourcing configuration.
config_value() {
  awk -v section="$2" -v key="$3" '
    /^[[:space:]]*\[/ { line=$0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", line); active=(line==section); next }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print
    }
  ' "$1"
}

validate_destination() {
  local marker="${root_dir}${desktop_env_file}"
  [[ -r "$marker" ]] || { fail "desktop marker is missing: $marker"; return 1; }
  # The image marker is data, not shell code or a retained /etc preference.
  case "$(cat "$marker")" in
    CURRENT_DESKTOP=gnome) desktop=gnome; selected=gdm.service; session=gnome.desktop ;;
    CURRENT_DESKTOP=cosmic) desktop=cosmic; selected=cosmic-greeter.service; session=cosmic.desktop ;;
    *) fail "invalid CURRENT_DESKTOP in $marker (expected gnome or cosmic)"; return 1 ;;
  esac
  vendor_unit="${root_dir}/usr/lib/systemd/system/${selected}"
  [[ -f "$vendor_unit" ]] || { fail "missing destination unit: $selected ($vendor_unit)"; return 1; }
  [[ "$(config_value "$vendor_unit" Install Alias)" == display-manager.service ]] || {
    fail "$selected does not provide Alias=display-manager.service"; return 1;
  }
  [[ -r "${root_dir}/usr/share/wayland-sessions/$session" ]] || {
    fail "missing destination session: $session"; return 1;
  }
  local session_file="${root_dir}/usr/share/wayland-sessions/$session"
  local executable="/usr/bin/gnome-session" exec_value
  if [[ "$selected" == cosmic-greeter.service ]]; then
    executable="/usr/bin/start-cosmic"
    [[ "$(config_value "$vendor_unit" Service ExecStart)" == 'greetd --config /etc/greetd/cosmic-greeter.toml' ||
       "$(config_value "$vendor_unit" Service ExecStart)" == '/usr/bin/greetd --config /etc/greetd/cosmic-greeter.toml' ]] || {
      fail "unexpected COSMIC ExecStart; expected native greetd --config /etc/greetd/cosmic-greeter.toml"; return 1;
    }
    [[ -r "${root_dir}/etc/greetd/cosmic-greeter.toml" ]] || {
      fail "missing COSMIC configuration: /etc/greetd/cosmic-greeter.toml"; return 1;
    }
    [[ -r "${root_dir}/etc/pam.d/cosmic-greeter" || -r "${root_dir}/usr/lib/pam.d/cosmic-greeter" ]] || {
      fail "missing COSMIC PAM stack in /etc/pam.d or /usr/lib/pam.d"; return 1;
    }
    if current_pam_override; then
      [[ -r "${root_dir}/usr/lib/pam.d/cosmic-greeter" ]] || {
        fail "missing vendor PAM stack for Current-owned COSMIC override"; return 1;
      }
    fi
    local config="${root_dir}/etc/greetd/cosmic-greeter.toml"
    [[ "$(config_value "$config" general service)" == '"cosmic-greeter"' &&
       "$(config_value "$config" default_session command)" == '"cosmic-greeter-start"' &&
       "$(config_value "$config" default_session user)" == '"cosmic-greeter"' ]] || {
      fail "invalid COSMIC service/command/user in $config"; return 1;
    }
    for exec_value in greetd cosmic-greeter-start cosmic-greeter-daemon cosmic-comp; do
      [[ -x "${root_dir}/usr/bin/$exec_value" ]] || { fail "missing COSMIC executable: $exec_value"; return 1; }
    done
  else
    # Fedora installs /usr/bin/gdm; Alma 9/10 install /usr/sbin/gdm.
    exec_value="$(config_value "$vendor_unit" Service ExecStart)"
    case "$exec_value" in
      /usr/bin/gdm|/usr/sbin/gdm) ;;
      *) fail "invalid GDM ExecStart: $exec_value"; return 1 ;;
    esac
    [[ -x "${root_dir}$exec_value" ]] || { fail "missing GDM executable: $exec_value"; return 1; }
    [[ -r "${root_dir}/etc/gdm/custom.conf" ]] || {
      fail "missing GDM configuration: /etc/gdm/custom.conf"; return 1;
    }
  fi
  exec_value="$(config_value "$session_file" 'Desktop Entry' Exec)"
  # Alma 9's GNOME entry uses a PATH-resolved gnome-session command.
  if [[ "$desktop" == gnome && "${exec_value%% *}" == gnome-session ]]; then
    exec_value="/usr/bin/$exec_value"
  fi
  [[ "${exec_value%% *}" == "$executable" && -x "${root_dir}$executable" &&
     "$(config_value "$session_file" 'Desktop Entry' DesktopNames)" =~ ^${desktop^^}\;?$ ]] || {
    fail "invalid destination session contract: $session_file ($exec_value)"; return 1;
  }
  validate_ownership
}

current_pam_override() {
  local pam="${root_dir}/etc/pam.d/cosmic-greeter"
  [[ -f "$pam" && ! -L "$pam" &&
     "$(head -n 1 "$pam")" == '# Managed by Current from /usr/lib/pam.d/cosmic-greeter' ]]
}

retire_current_pam_override() {
  if [[ "$desktop" == cosmic ]] && current_pam_override; then
    rm -f "${root_dir}/etc/pam.d/cosmic-greeter" || { fail "failed to retire Current-owned COSMIC PAM override"; return 1; }
    log "retired Current-owned COSMIC PAM override; using native vendor stack"
  fi
}

validate_ownership() {
  local system_dir="${root_dir}/etc/systemd/system" path target
  for path in display-manager.service "$selected"; do
    if [[ -e "$system_dir/$path" && ! -L "$system_dir/$path" ]]; then
      fail "administrator unit override at $system_dir/$path; use /etc/current/workstation-dm-unmanaged to take ownership"
      return 1
    fi
    if [[ -L "$system_dir/$path" ]]; then
      target="$(readlink "$system_dir/$path")"
      case "$target" in
        /dev/null|*/gdm.service|*/cosmic-greeter.service|*/greetd.service) ;;
        *) fail "administrator alias at $system_dir/$path -> $target; use /etc/current/workstation-dm-unmanaged"; return 1 ;;
      esac
    fi
  done
}

persistent_systemctl() {
  # Offline operations avoid implicit reloads halfway through reconciliation.
  systemctl --root="${root_dir:-/}" --no-reload "$@"
}

verify_alias() {
  local alias="${root_dir}/etc/systemd/system/display-manager.service" target resolved
  [[ -L "$alias" ]] || { fail "display-manager.service is not a symlink for $selected"; return 1; }
  target="$(readlink "$alias")"
  [[ "$target" != /dev/null ]] || { fail "wrong or masked display-manager.service alias: /dev/null"; return 1; }
  if [[ "$target" == /* ]]; then
    target="${root_dir}${target}"
  else
    target="$(dirname "$alias")/$target"
  fi
  resolved="$(readlink -e "$target")" || {
    fail "dangling display-manager.service alias: $(readlink "$alias")"; return 1;
  }
  [[ "$resolved" == "$(readlink -e "$vendor_unit")" ]] || {
    fail "wrong or masked display-manager.service alias: $resolved (expected $selected)"; return 1;
  }
}

select_destination() {
  local system_dir="${root_dir}/etc/systemd/system" saved path
  mkdir -p "$system_dir" || return 1
  saved="$(mktemp -d)" || return 1
  for path in display-manager.service "$selected"; do
    if [[ -L "$system_dir/$path" ]]; then
      cp -a "$system_dir/$path" "$saved/$path" || { rm -rf "$saved"; return 1; }
    fi
  done
  if [[ "$(readlink "$system_dir/$selected" || :)" == /dev/null ]]; then
    log "removing stale mask on selected $selected"
  fi
  if persistent_systemctl unmask "$selected" display-manager.service &&
     persistent_systemctl enable --force "$selected" && verify_alias; then
    rm -rf "$saved"
    return 0
  fi
  log "failed to select $selected; restoring previous alias and selected-unit mask"
  for path in display-manager.service "$selected"; do
    rm -f "$system_dir/$path"
    if [[ -L "$saved/$path" ]]; then cp -a "$saved/$path" "$system_dir/$path"; fi
  done
  rm -rf "$saved"
  return 1
}

retire_competitors() {
  local unit link
  for unit in "${managed_units[@]}"; do
    [[ "$unit" != "$selected" ]] || continue
    if [[ -f "${root_dir}/usr/lib/systemd/system/$unit" ]]; then
      persistent_systemctl disable "$unit" || { fail "failed to disable competitor $unit"; return 1; }
    fi
    # Even an absent package can leave a dangling enablement link after rebase.
    while IFS= read -r -d '' link; do
      rm -f "$link" || { fail "failed to remove stale enablement: $link"; return 1; }
    done < <(
      find "${root_dir}/etc/systemd/system" -path '*.wants/*' -type l -name "$unit" -print0
    )
  done
}

# Called before systemd loads units, and again on daemon-reload. Only write into
# the supplied generator directory: /etc repair belongs to the oneshot service.
generate_units() {
  local early="${2:-$1}" unit competitors=""
  validate_destination || return 1
  validate_current_wiring || return 1
  mkdir -p "$early/$selected.d" || return 1
  ln -s "$vendor_unit" "$early/$selected" || return 1
  ln -s "$vendor_unit" "$early/display-manager.service" || return 1
  ln -s "${root_dir}/usr/lib/systemd/system/graphical.target" "$early/default.target" || return 1
  for unit in "${managed_units[@]}"; do
    [[ "$unit" != "$selected" ]] || continue
    ln -s /dev/null "$early/$unit" || return 1
    competitors+=" $unit"
  done
  cat > "$early/$selected.d/50-current-workstation.conf" <<EOF
[Unit]
Requires=current-workstation-dm-apply.service
After=current-workstation-dm-apply.service
Conflicts=$competitors
EOF
}

validate_current_wiring() {
  local helper="${root_dir}/usr/libexec/current-workstation-dm-apply"
  local generator="${root_dir}/usr/lib/systemd/system-generators/current-workstation-dm-generator"
  local service="${root_dir}/usr/lib/systemd/system/current-workstation-dm-apply.service"
  [[ -x "$helper" && -x "$generator" && -r "$service" ]] || {
    fail "missing executable helper/generator or reconciliation service"; return 1;
  }
  { bash -n "$helper" && bash -n "$generator"; } || { fail "helper/generator syntax check failed"; return 1; }
  [[ "$(config_value "$service" Service ExecStart)" == /usr/libexec/current-workstation-dm-apply &&
     "$(config_value "$service" Service Type)" == oneshot &&
     "$(config_value "$service" Service RemainAfterExit)" == yes &&
     "$(config_value "$service" Unit Before)" == graphical.target &&
     "$(config_value "$service" Unit After)" == local-fs.target &&
     "$(config_value "$service" Install WantedBy)" == multi-user.target ]] || {
    fail "invalid helper/service ordering contract"; return 1;
  }
  grep -Fqx 'exec /usr/libexec/current-workstation-dm-apply --generate "$@"' "$generator" || {
    fail "generator does not delegate to the shared reconciliation helper"; return 1;
  }
}

main() {
  if [[ "${1:-}" != --check && -e "${root_dir}/etc/current/workstation-dm-unmanaged" ]]; then
    log "administrator owns display-manager selection (workstation-dm-unmanaged)"
    return 0
  fi
  if [[ "${1:-}" == --generate ]]; then
    shift
    generate_units "$@"
    return
  fi
  validate_destination || return 1
  if [[ "${1:-}" == --check ]]; then
    [[ "${2:-}" == "$desktop" ]] || { fail "expected desktop ${2:-<missing>}, marker selects $desktop"; return 1; }
    validate_current_wiring || return 1
    log "validated $desktop: $selected, $session and native configuration"
    return 0
  fi
  [[ $# == 0 ]] || { fail "unexpected argument: $1"; return 1; }
  log "selecting $selected ($session)"
  select_destination || return 1
  retire_current_pam_override || return 1
  # Only retire the old owner after the replacement has been selected and checked.
  retire_competitors || return 1
  verify_alias || return 1
  persistent_systemctl set-default graphical.target || { fail "failed to set graphical.target"; return 1; }
  log "selected $selected; persistent alias verified"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
