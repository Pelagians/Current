#!/bin/sh
set -eu

if [ "${1:-}" = setup ]; then
  shift
  exec /usr/libexec/current-setup "$@"
fi

JUSTFILE="/usr/share/current/just/index.just"

if [ ! -f "$JUSTFILE" ]; then
  echo "current: justfile not found at $JUSTFILE" >&2
  exit 1
fi

JUST_BIN=""

if [ -x /usr/bin/just ]; then
  JUST_BIN="/usr/bin/just"
elif [ -x /usr/local/bin/just ]; then
  JUST_BIN="/usr/local/bin/just"
elif JUST_BIN="$(command -v just 2>/dev/null)"; then
  :
else
  echo "current: could not find just in /usr/bin, /usr/local/bin, or PATH" >&2
  exit 1
fi

exec "$JUST_BIN" --justfile "$JUSTFILE" "$@"
